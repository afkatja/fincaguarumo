# Qdrant Cloud Configuration
# Copy this to your .env.local for both development and production

# Vector store configuration
VECTOR_STORE=qdrant
ENABLE_BINARY_QUANTIZATION=true

# Qdrant Cloud Cluster (finca-guarumo-embeddings)
QDRANT_URL=https://your-cluster-endpoint.qdrant.tech
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Environment-specific settings
NODE_ENV=development  # Change to 'production' for production deploy

# Existing required variables
TOGETHER_API_KEY=your_together_ai_api_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Different API keys per environment
# QDRANT_DEV_API_KEY=dev_api_key_here
# QDRANT_PROD_API_KEY=prod_api_key_here
