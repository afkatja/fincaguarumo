
# Semantic RAG Configuration Example
# Copy this to .env.local for development or set in Netlify for production

# Embedding Configuration
# ---------------------

# Prefer local embeddings (Ollama) in development
EMBEDDING_PREFER_LOCAL=true

# Enable fallback to remote embeddings (TogetherAI)
EMBEDDING_FALLBACK_TO_REMOTE=true

# Timeout for local embedding service (milliseconds)
EMBEDDING_LOCAL_TIMEOUT=10000

# Local Ollama Configuration (Development Only)
# OLLAMA_HOST=http://localhost:11434

# Remote TogetherAI Configuration
# ---------------------
# Get your API key from https://together.ai
TOGETHER_API_KEY=your_together_ai_api_key_here

# Supabase Configuration
# ---------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ========================================
# Role-Based Model Provider Configuration
# ========================================
# Canonical naming convention for role-based AI model selection
# See: feature-specs/FG-29-role-based-model-provider.md

# Generation Roles
# ---------------------
# Primary generation model (general chat, content generation)
GEN_MODEL_PRIMARY_PROVIDER=together
GEN_MODEL_PRIMARY_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
GEN_MODEL_PRIMARY_FALLBACKS=openai:gpt-4o-mini,anthropic:claude-3-haiku-20240307

# Tools generation model (structured output, tool-calling)
GEN_MODEL_TOOLS_PROVIDER=together
GEN_MODEL_TOOLS_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
GEN_MODEL_TOOLS_FALLBACKS=openai:gpt-4o-mini

# Fast generation model (cost-effective, low-risk tasks)
GEN_MODEL_FAST_PROVIDER=together
GEN_MODEL_FAST_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
GEN_MODEL_FAST_FALLBACKS=

# Evaluation Role
# ---------------------
# Evaluation model (faithfulness judging, quality assessment)
EVAL_MODEL_PROVIDER=together
EVAL_MODEL_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
EVAL_MODEL_FALLBACKS=openai:gpt-4o-mini

# Embedding Roles
# ---------------------
# Local embedding model (development, Ollama)
EMBED_MODEL_LOCAL_PROVIDER=ollama
EMBED_MODEL_LOCAL_MODEL_ID=nomic-embed-text
EMBED_MODEL_LOCAL_FALLBACKS=

# Remote embedding model (production, TogetherAI)
EMBED_MODEL_REMOTE_PROVIDER=together
EMBED_MODEL_REMOTE_MODEL_ID=togethercomputer/m2-bert-80M-32k-retrieval
EMBED_MODEL_REMOTE_FALLBACKS=openai:text-embedding-3-small

# Backward Compatibility Aliases
# ---------------------
# These map to GEN_MODEL_PRIMARY_* for existing code
MAIN_MODEL_PROVIDER=together
MAIN_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3

# These map to EMBED_MODEL_REMOTE_* for existing code
EMBEDDING_MODEL_PROVIDER=together
EMBEDDING_MODEL_ID=togethercomputer/m2-bert-80M-32k-retrieval

# Manual Override (Emergency Use Only)
# ---------------------
# Override primary generation model for runtime production traffic
# Scope: Only affects runtime production traffic for primary generation role
# Does not affect: Benchmark runs, evaluation routes, tools routes
GEN_MODEL_PRIMARY_OVERRIDE_PROVIDER=
GEN_MODEL_PRIMARY_OVERRIDE_MODEL_ID=

# Provider API Keys
# ---------------------
# TogetherAI (for generation and remote embeddings)
TOGETHER_API_KEY=your_together_ai_api_key_here

# OpenAI (fallback provider)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (fallback provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Mistral (legacy, for backward compatibility)
MISTRAL_API_KEY=your_mistral_api_key_here

# Legacy Embedding Configuration (Deprecated - use EMBED_MODEL_* above)
# ---------------------
# Prefer local embeddings (Ollama) in development
EMBEDDING_PREFER_LOCAL=true

# Enable fallback to remote embeddings (TogetherAI)
EMBEDDING_FALLBACK_TO_REMOTE=true

# Timeout for local embedding service (milliseconds)
EMBEDDING_LOCAL_TIMEOUT=10000

# Development vs Production Notes:
# ---------------------------------------------
# Development (.env.local):
# - EMBEDDING_PREFER_LOCAL=true (use Ollama first)
# - TOGETHER_API_KEY optional (fallback only)
#
# Production (Netlify environment):
# - EMBEDDING_PREFER_LOCAL=false (use TogetherAI first)
# - TOGETHER_API_KEY required (primary method)
# - OLLAMA_HOST not used

# Quick Setup Commands:
# ---------------------------------------------
# 1. Install Ollama (development):
#    curl -fsSL https://ollama.ai/install.sh | sh
#
# 2. Pull Mistral model:
#    ollama pull mistral
#
# 3. Start Ollama service:
#    ollama serve
#
# 4. Test semantic RAG:
#    npm run semantic-rag:test
#
# 5. Initialize embeddings:
#    npm run semantic-rag:init

# Feature Flags
# Set to 'true' to display the travel-proud-logo.png instead of the regular logo
NEXT_PUBLIC_USE_TRAVEL_PROUD_LOGO=false

# Sanity Configuration
# ---------------------
NEXT_PUBLIC_SANITY_STUDIO_PROJECT_ID=1yaom9qu
NEXT_PUBLIC_SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2024-08-04

# Sanity Authentication Tokens
# IMPORTANT: Use NEXT_PUBLIC_ prefix for client-side access
NEXT_PUBLIC_SANITY_API_READ_TOKEN=your_read_token_here
SANITY_API_READ_TOKEN=your_read_token_here
SANITY_API_WRITE_TOKEN=your_write_token_here

# Stripe Configuration
# ---------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_API_KEY=sk_test_...

# Environment Detection
# ---------------------
NEXT_PUBLIC_NETLIFY_ENV=development

