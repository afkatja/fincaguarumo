
# Semantic RAG Configuration Example
# Copy this to .env.local for development or set in Netlify for production

# Embedding Configuration
# ---------------------

# Prefer local embeddings (Ollama) in development
EMBEDDING_PREFER_LOCAL=true

# Enable fallback to remote embeddings (TogetherAI)
EMBEDDING_FALLBACK_TO_REMOTE=true

# Timeout for local embedding service (milliseconds)
EMBEDDING_LOCAL_TIMEOUT=10000

# Local Ollama Configuration (Development Only)
# OLLAMA_HOST=http://localhost:11434

# Remote TogetherAI Configuration
# ---------------------
# Get your API key from https://together.ai
TOGETHER_API_KEY=your_together_ai_api_key_here

# Supabase Configuration
# ---------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Existing Mistral API (for chat)
MISTRAL_API_KEY=your_mistral_api_key_here

# Development vs Production Notes:
# ---------------------------------------------
# Development (.env.local):
# - EMBEDDING_PREFER_LOCAL=true (use Ollama first)
# - TOGETHER_API_KEY optional (fallback only)
#
# Production (Netlify environment):
# - EMBEDDING_PREFER_LOCAL=false (use TogetherAI first)
# - TOGETHER_API_KEY required (primary method)
# - OLLAMA_HOST not used

# Quick Setup Commands:
# ---------------------------------------------
# 1. Install Ollama (development):
#    curl -fsSL https://ollama.ai/install.sh | sh
#
# 2. Pull Mistral model:
#    ollama pull mistral
#
# 3. Start Ollama service:
#    ollama serve
#
# 4. Test semantic RAG:
#    npm run semantic-rag:test
#
# 5. Initialize embeddings:
#    npm run semantic-rag:init

# Feature Flags
# Set to 'true' to display the travel-proud-logo.png instead of the regular logo
NEXT_PUBLIC_USE_TRAVEL_PROUD_LOGO=false

# Sanity Configuration
# ---------------------
NEXT_PUBLIC_SANITY_STUDIO_PROJECT_ID=1yaom9qu
NEXT_PUBLIC_SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2024-08-04

# Sanity Authentication Tokens
# IMPORTANT: Use NEXT_PUBLIC_ prefix for client-side access
NEXT_PUBLIC_SANITY_API_READ_TOKEN=your_read_token_here
SANITY_API_READ_TOKEN=your_read_token_here
SANITY_API_WRITE_TOKEN=your_write_token_here

# Stripe Configuration
# ---------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_API_KEY=sk_test_...

# Environment Detection
# ---------------------
NEXT_PUBLIC_VERCEL_ENV=development

