
# Semantic RAG Configuration Example
# Copy this to .env.local for development or set in Netlify for production

# Embedding Configuration
# ---------------------

# Prefer local embeddings (Ollama) in development
EMBEDDING_PREFER_LOCAL=true

# Enable fallback to remote embeddings (TogetherAI)
EMBEDDING_FALLBACK_TO_REMOTE=true

# Timeout for local embedding service (milliseconds)
EMBEDDING_LOCAL_TIMEOUT=10000

# Local Ollama Configuration (Development Only)
# OLLAMA_HOST=http://localhost:11434

# Remote TogetherAI Configuration
# ---------------------
# Get your API key from https://together.ai
TOGETHER_API_KEY=your_together_ai_api_key_here

# Supabase Configuration
# ---------------------
# Server-side (API routes, sync services)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SITE_URL=http://localhost:3000

# Client-side (browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Existing Mistral API (for chat)
MISTRAL_API_KEY=your_mistral_api_key_here

# Development vs Production Notes:
# ---------------------------------------------
# Development (.env.local):
# - EMBEDDING_PREFER_LOCAL=true (use Ollama first)
# - TOGETHER_API_KEY optional (fallback only)
#
# Production (Netlify environment):
# - EMBEDDING_PREFER_LOCAL=false (use TogetherAI first)
# - TOGETHER_API_KEY required (primary method)
# - OLLAMA_HOST not used

# Quick Setup Commands:
# ---------------------------------------------
# 1. Install Ollama (development):
#    curl -fsSL https://ollama.ai/install.sh | sh
#
# 2. Pull Mistral model:
#    ollama pull mistral
#
# 3. Start Ollama service:
#    ollama serve
#
# 4. Test semantic RAG:
#    npm run semantic-rag:test
#
# 5. Initialize embeddings:
#    npm run semantic-rag:init

# Feature Flags
# Set to 'true' to display the travel-proud-logo.png instead of the regular logo
NEXT_PUBLIC_USE_TRAVEL_PROUD_LOGO=false

# Sanity Configuration
# ---------------------
NEXT_PUBLIC_SANITY_STUDIO_PROJECT_ID=1yaom9qu
NEXT_PUBLIC_SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2024-08-04

# Sanity Authentication Tokens
# IMPORTANT: Use NEXT_PUBLIC_ prefix for client-side access
NEXT_PUBLIC_SANITY_API_READ_TOKEN=your_read_token_here
SANITY_API_READ_TOKEN=your_read_token_here
SANITY_API_WRITE_TOKEN=your_write_token_here

# Stripe Configuration
# ---------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_API_KEY=sk_test_...

# Environment Detection
# ---------------------
NEXT_PUBLIC_VERCEL_ENV=development

# MailerSend — used for booking confirmations + custom admin auth emails.
# These are also the exact values you paste into the Supabase Custom SMTP
# panel (Authentication → Providers → Email → Custom SMTP) to replace
# Supabase's rate-limited built-in SMTP pool:
#   SMTP Host      → smtp.mailersend.net
#   Port           → 587
#   TLS/STARTTLS   → STARTTLS
#   Username       → MAILERSEND_SMTP_USERNAME (see below)
#   Password       → MAILERSEND_SMTP_PASSWORD (create one in MailerSend →
#                    Domain → SMTP credentials, it is NOT the API token)
#   Sender Name    → "Finca Guarumo Admin"
#   Sender Email   → MAILERSEND_FROM_EMAIL
#
# If you enable Custom SMTP in the Supabase dashboard, all confirmation,
# recovery, magic-link and invite emails from Supabase Auth will be routed
# through MailerSend with their normal send volumes, and the below custom
# pg_net-triggered sender becomes an optional fallback/re-send mechanism.
MAILERSEND_TOKEN=your_mailersend_api_token
MAILERSEND_FROM_EMAIL=info@fincaguarumo.com
MAILERSEND_SMTP_USERNAME=your_smtp_username@trial-pq3enl61234z2vwr.mlsender.net
MAILERSEND_SMTP_PASSWORD=your_smtp_password
CONTACT_EMAIL=info@fincaguarumo.com
CONTACT_PHONE=+506 87495341

# Admin signup custom email hook.
# -------------------------------------------------------------
# The trigger installed in migration 016 fires AFTER INSERT on auth.users
# and calls the Next.js /api/auth/custom-send-confirmation endpoint via
# pg_net. Both the trigger (Postgres pgcrypto HMAC) and the Next.js route
# share this secret. Generate a secure value:
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
# Then store it in TWO places:
#   1. Netlify/hosting env var as SUPABASE_AUTH_WEBHOOK_SECRET
#   2. Supabase Vault as a secret named `supabase_auth_webhook_secret`
#      (SELECT vault.create_secret('<hex>', 'supabase_auth_webhook_secret'))
SUPABASE_AUTH_WEBHOOK_SECRET=your_64_char_random_hex_hmac_secret_here

# Optional: override the pg_net trigger endpoint via Vault so Netlify
# preview deploys can have the trigger POST to a preview-specific URL.
# Create another Vault secret with name `custom_confirmation_hook_url`
# containing the absolute URL to /api/auth/custom-send-confirmation.
# Migration 016 prefers the Vault value over the hard-coded default.

# Feature flag: when true, the admin login page's sign-up flow calls the
# custom MailerSend endpoint directly (with the HMAC header secret) in
# addition to Supabase's built-in sender. This is useful on preview
# deployments where preview hosts are not in the Supabase Redirect URL
# allowlist and Supabase silently rewrites redirects back to localhost.
NEXT_PUBLIC_USE_CUSTOM_AUTH_SMTP=false

# Per-deploy site origin. In netlify.toml we set NEXT_PUBLIC_SITE_URL to
# $DEPLOY_URL so this matches the actual Netlify deploy host, overriding
# any local .env value when built on Netlify infrastructure. Keep this
# line here so the Next.js dev server on localhost still resolves.
NEXT_PUBLIC_SITE_URL=https://localhost:3000

