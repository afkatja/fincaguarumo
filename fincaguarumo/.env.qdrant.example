# Qdrant Vector Database Configuration
# Add these to your .env.local file to enable binary quantization

# Vector store selection: 'pgvector' or 'qdrant'
VECTOR_STORE=qdrant

# Enable binary quantization for 32x memory reduction and 40x speed improvement
ENABLE_BINARY_QUANTIZATION=true

# Qdrant configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Existing TogetherAI configuration (required)
TOGETHER_API_KEY=your_together_ai_api_key_here

# Existing Supabase configuration (required for migration)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_API_KEY=your_supabase_api_key
