# AI Model Configuration
# Main generation model (with tools)
MAIN_MODEL_PROVIDER=mistral
MAIN_MODEL_ID=mistral-large-latest
MAIN_MODEL_MAX_TOKENS=1000
MAIN_MODEL_TEMPERATURE=0.7

# Evaluation model (without tools, uses cached data)
EVALUATOR_MODEL_PROVIDER=perplexity
EVALUATOR_MODEL_ID=sonar-pro
EVALUATOR_MODEL_MAX_TOKENS=2000
EVALUATOR_MODEL_TEMPERATURE=0.1

# API Keys (required for each provider)
MISTRAL_API_KEY=your_mistral_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Alternative providers (uncomment if needed)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Other existing environment variables...
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# VERCEL_URL=
# SANITY_PROJECT_ID=
# SANITY_DATASET=
# SANITY_API_READ_TOKEN=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# TOGETHERAI_API_KEY=
