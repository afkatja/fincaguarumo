{
  "name": "fincaguarumo",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "next dev --experimental-https",
    "dev:http": "next dev --port=3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "npx tsc --noEmit",
    "codegen": "sanity schema extract --enforce-required-fields && npx sanity typegen generate",
    "i18n:build": "npx tsc scripts/translate.ts --outDir dist --esModuleInterop --allowSyntheticDefaultImports --module NodeNext --moduleResolution NodeNext --skipLibCheck",
    "i18n:run": "npm run i18n:build && node dist/scripts/translate.js",
    "i18n:watch": "nodemon --watch /src/messages/en.json --exec \"npm run i18n:run\"",
    "prepare": "husky",
    "translate": "npm run i18n:run",
    "manual-email": "NODE_ENV=production npx tsc --project tsconfig.build.json && MAILERSEND_FROM_EMAIL='info@fincaguarumo.com' CONTACT_EMAIL='info@fincaguarumo.com' CONTACT_PHONE='+506 87495341' NODE_ENV=production node dist/scripts/send-email.js",
    "migrate:villa-bruno": "npx tsx --tsconfig tsconfig.scripts.json --require dotenv/config scripts/migrate-villa-bruno-to-accommodation.ts",
    "migrate:villa-bruno:dry-run": "npx tsx --tsconfig tsconfig.scripts.json --require dotenv/config scripts/migrate-villa-bruno-to-accommodation.ts --dry-run",
    "migrate:reviews": "npx tsx --tsconfig tsconfig.scripts.json --require dotenv/config scripts/migrate-reviews.ts",
    "eval": "npx tsx --require dotenv/config test-evaluation.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "lint-staged": {
    "src/messages/en.json": [
      "npm run i18n:run"
    ]
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.5.7",
    "@netlify/functions": "^5.3.0",
